---
/**
 * NewsArticle: giao diện một bài viết trong collection `posts`, dùng chung cho
 * /news/{slug} (EN) và /vi/news/{slug} (VI). Hai route đó gọi
 * loadArticle() (src/utils/news.ts) rồi spread kết quả vào component này.
 *
 * Bố cục: header tối (liên kết "All news", ngày, <h1>, đoạn trích) -> khối nền
 * trắng (ảnh đại diện + thân bài Portable Text) -> khối "More news" gồm tối đa
 * 3 bài mới khác bằng NewsCard.
 */
import { getEmDashCollection, type ContentEntry } from "emdash";
import { Image, PortableText } from "emdash/ui";
import type { Post } from "../../../emdash-env";
import Base from "../../layouts/Base.astro";
import NewsCard from "./NewsCard.astro";
import { type Locale, toLocale, useTranslations } from "../../i18n/ui";
import { formatNewsDate, newsPath } from "../../utils/news";

// Props khớp giá trị loadArticle() trả về (post + meta SEO cho Base).
interface Props {
	post: ContentEntry<Post>;
	title?: string;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	// URL bài này ở từng locale (hoặc danh sách tin nếu thiếu bản dịch) cho nút EN | VI.
	alternates?: Partial<Record<Locale, string>>;
}

// `post` dùng trong template; phần còn lại (title, description, canonical...) là `meta` cho Base.
const { post, ...meta } = Astro.props;
// Locale suy ra từ URL hiện tại (/vi/... => "vi", còn lại "en"); dùng cho chuỗi UI, ngày và liên kết.
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
// Ưu tiên ngày xuất bản; bài chưa có publishedAt (ví dụ xem preview bản nháp) lấy ngày tạo.
const date = post.data.publishedAt ?? post.data.createdAt;

// A few other recent articles under the body.
// Lấy 4 bài mới nhất CÙNG locale (luôn truyền `locale`, nếu không sẽ trộn cả hai ngôn ngữ).
// Lấy 4 để sau khi loại bài đang xem vẫn còn đủ 3 bài.
const { entries: recent } = await getEmDashCollection("posts", {
	locale,
	orderBy: { published_at: "desc" },
	limit: 4,
});
// So sánh bằng entry.data.id (ULID trong DB), không dùng entry.id vì id đó là slug nên đổi theo locale.
const more = recent.filter((entry) => entry.data.id !== post.data.id).slice(0, 3);
// Template (ghi chú đặt ở đây vì comment {/* */} ở gốc template sẽ chèn thêm khoảng trắng/xuống dòng trước <!doctype> của layout):
// - title/description/canonical/robots/alternates đi qua {...meta}. pageTitle là tên bài (cho ngữ cảnh trang của EmDash). content cho EmDash biết entry nào của collection posts đang hiển thị (id = ULID, slug = post.id).
---

<Base
	{...meta}
	pageTitle={post.data.title}
	content={{ collection: "posts", id: post.data.id, slug: post.id }}
>
	{/* Header tối: quay lại danh sách, ngày xuất bản, tiêu đề, đoạn trích. */}
	<header class="mx-auto max-w-3xl px-4 py-12 sm:px-8 sm:py-16">
		{/* newsPath(locale) = /news hoặc /vi/news: về danh sách tin cùng ngôn ngữ. */}
		<a href={newsPath(locale)} class="text-sm font-bold text-sky-400 hover:text-sky-300">
			← {t("news.all")}
		</a>
		{/* datetime theo ISO cho máy đọc; formatNewsDate hiển thị ngày dạng dễ đọc theo locale. */}
		<time datetime={date.toISOString()} class="mt-6 block text-xs font-semibold tracking-[0.2em] text-sky-400 uppercase">
			{formatNewsDate(date, locale)}
		</time>
		{/* Spread page.edit.* để sửa trực tiếp trên trang (no-op ngoài chế độ edit). */}
		<h1
			class="mt-3 font-jakarta text-3xl leading-tight font-black text-white sm:text-4xl md:text-5xl"
			{...post.edit.title}
		>
			{post.data.title}
		</h1>
		{/* Đoạn trích là tuỳ chọn: chỉ in khi bài có excerpt. */}
		{
			post.data.excerpt && (
				<p class="mt-5 text-lg leading-relaxed text-sky-100/75" {...post.edit.excerpt}>
					{post.data.excerpt}
				</p>
			)
		}
	</header>

	{/* Khối nền trắng chứa ảnh đại diện và thân bài (chữ tối trên nền trắng). */}
	<section class="bg-white pb-16 sm:pb-20">
		{/* Ảnh đại diện (tuỳ chọn). Giá trị là object { src, alt } nên render bằng <Image image=...> của emdash/ui; sm:-mt-8 kéo ảnh chồng nhẹ lên header tối. */}
		{
			post.data.featured_image && (
				<div class="mx-auto max-w-5xl px-4 sm:px-8" {...post.edit.featured_image}>
					<Image
						image={post.data.featured_image}
						class="w-full rounded-2xl object-cover shadow-xl sm:-mt-8"
						sizes="(max-width: 1024px) 100vw, 1024px"
					/>
				</div>
			)
		}
		{/* Thân bài: <PortableText> chuyển rich-text của EmDash thành HTML. Lớp .article-body (src/styles/global.css) định kiểu typography. `?? []` phòng trường hợp bài chưa có nội dung. */}
		<div class="article-body mx-auto max-w-3xl px-4 pt-10 sm:px-8 sm:pt-14" {...post.edit.content}>
			<PortableText value={post.data.content ?? []} />
		</div>
	</section>

	{/* Khối "More news": ẩn hẳn nếu không có bài nào khác để gợi ý. */}
	{
		more.length > 0 && (
			<section class="border-t border-slate-200 bg-slate-50 py-14 sm:py-16">
				<div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
					<div class="mb-8 flex items-end justify-between gap-4">
						<div>
							<h2 class="font-jakarta text-2xl font-bold text-slate-900">{t("news.more")}</h2>
							<div class="mt-3 h-0.5 w-12 rounded-full bg-sky-600" />
						</div>
						<a href={newsPath(locale)} class="text-sm font-bold text-sky-700 hover:text-sky-600">
							{t("news.all")} →
						</a>
					</div>
					{/* Lưới thẻ: 1 cột trên mobile, 2 cột từ sm, 3 cột từ lg. */}
					<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{more.map((entry) => (
							<NewsCard post={entry} />
						))}
					</div>
				</div>
			</section>
		)
	}
</Base>
