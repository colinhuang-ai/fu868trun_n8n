---
/**
 * Plants.astro - render block `cases_plants` (tên trong admin: "Processing plants"): danh sách nhà máy chế biến
 * nhóm theo dòng sản phẩm (Shrimp, Surimi...).
 *
 * KHÁC các block thuần nội dung: block này chỉ lưu CẤU HÌNH hiển thị còn dữ liệu nhà máy được đọc lúc request từ
 * collection `plants` (getEmDashCollection). Vì vậy editor muốn thêm/sửa/đổi thứ tự nhà máy thì sửa entry trong
 * collection Plants, không sửa trang. (Cột "Main Plants" ở footer cũng đọc cùng collection.)
 *
 * Fields của block (blockType("cases_plants") trong scripts/build-seed.mjs):
 * - headline : string, bắt buộc.   - eyebrow : string, tùy chọn.   - anchor_id : id section (vd "plants").
 * - groups[] : repeater tối đa 4; mỗi nhóm có `line` (select: shrimp | surimi | cephalopod | fishmeal, khớp field
 *              `line` của plants) và `label` (nhãn hiển thị của nhóm, vd "Shrimp · 18,000-20,000 t/yr").
 *              Seed hiện chỉ cấu hình 2 nhóm shrimp và surimi, nên nhà máy cephalopod/fishmeal không hiện ở block này.
 *
 * Fields của mỗi entry `plants` được dùng: title, code (mã xuất khẩu, vd DL 113), province, address, image,
 * sort_order (thứ tự hiển thị). Mỗi locale có một dòng riêng (EN và VI) nên truy vấn phải truyền `locale`.
 *
 * Bố cục: nhóm có <= 2 nhà máy dùng thẻ lớn (2 cột, ảnh cao, hiện tỉnh); nhóm nhiều hơn dùng thẻ gọn (3 cột).
 */
// API đọc collection của EmDash. Chạy ở server (output: "server") nên không cần getStaticPaths.
import { getEmDashCollection } from "emdash";
// Type-only: kiểu props mà <Blocks> truyền cho component block.
import { type BlockComponentProps } from "emdash/ui";
// Union kiểu mọi block, sinh vào emdash-env.d.ts.
import type { PageContentBlock } from "../../../emdash-env";
// Ô ảnh dùng chung (ảnh thật hoặc placeholder nét đứt nếu chưa upload).
import PhotoSlot from "../PhotoSlot.astro";
// Chuẩn hóa locale cho truy vấn collection và nhất quán với cả site.
import { toLocale } from "../../i18n/ui";

// Thu hẹp union xuống block có _type = "cases_plants".
type PlantsBlock = Extract<PageContentBlock, { _type: "cases_plants" }>;
// Props chuẩn của component block: { value, index, blockKey }.
type Props = BlockComponentProps<PlantsBlock>;

// `value` = dữ liệu block (headline, eyebrow, groups, anchor_id).
const { value } = Astro.props;
// Locale của request, bắt buộc truyền vào getEmDashCollection (nếu không, chỉ lấy bản mặc định EN).
const locale = toLocale(Astro.currentLocale);

// Với mỗi nhóm cấu hình trong block, truy vấn collection `plants` MỘT LẦN (song song bằng Promise.all thay vì
// tuần tự để không cộng dồn độ trễ D1; số nhóm tối đa 4 nên số truy vấn nhỏ).
// Kết quả: mảng nhóm { line, label, plants } với `plants` là danh sách entry của dòng sản phẩm đó.
const groups = await Promise.all(
	value.groups.map(async (group) => {
		// - locale: lấy đúng bản dịch EN hoặc VI.
		// - where.line: lọc theo dòng sản phẩm của nhóm (field select `line` của plants).
		// - orderBy.sort_order asc: thứ tự do editor đặt (field `Order` trong admin).
		// - limit 50: trần an toàn, dư nhiều so với 5 nhà máy hiện có.
		// Chỉ lấy `entries`; cacheHint trả kèm không được dùng ở block này (chỉ loadPage dùng cho cache trang).
		const { entries } = await getEmDashCollection("plants", {
			locale,
			where: { line: group.line },
			orderBy: { sort_order: "asc" },
			limit: 50,
		});
		// Giữ nguyên field của nhóm (line, label) và gắn thêm danh sách nhà máy thành `plants`.
		return { ...group, plants: entries };
	}),
);
---

{/*
	Section nền trắng. id từ anchor_id (|| undefined để không in id rỗng). Đệm dọc py-12 sm:py-16 md:py-20 hơi gọn hơn
	các block giới thiệu vì đây là phần danh sách.
*/}
<section id={value.anchor_id || undefined} class="bg-white py-12 sm:py-16 md:py-20">
	{/*
		Container; đệm ngang tăng dần px-4 / sm:px-8 / lg:px-12 (rộng hơn Features một chút để khớp khối danh sách).
	*/}
	<div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
		{/*
			Tiêu đề căn trái (khác kiểu canh giữa của Features/Timeline): eyebrow tùy chọn, h2 và gạch ngắn bg-sky-600 bên dưới.
			h2 dùng font-jakarta (Plus Jakarta Sans, --font-jakarta trong global.css).
		*/}
		<div class="mb-10">
			{
				value.eyebrow && (
					<span class="mb-2 block text-xs font-bold tracking-[0.3em] text-sky-600 uppercase">
						{value.eyebrow}
					</span>
				)
			}
			<h2 class="font-jakarta text-2xl font-bold text-slate-900 sm:text-3xl">{value.headline}</h2>
			<div class="mt-3 h-0.5 w-12 rounded-full bg-sky-600"></div>
		</div>
		{/*
			Duyệt từng nhóm đã nạp ở frontmatter. Mỗi nhóm: thanh nhãn (badge + đường kẻ) rồi lưới thẻ nhà máy.
			Phần thân hàm có large quyết định hai chế độ bố cục: nhóm có 2 nhà máy trở xuống dùng thẻ lớn (grid 2 cột từ md, ảnh h-48 sm:h-56,
			đệm p-5, hiện tỉnh), nhóm đông hơn dùng thẻ gọn (3 cột từ sm, ảnh h-36, đệm p-4, tên chữ nhỏ). Nhóm rỗng cũng vào
			nhánh large và chỉ in thanh nhãn với lưới trống.
			Class reveal cho cả nhóm hiện dần khi cuộn tới; class:list tự bỏ giá trị false nên mb-10 chỉ áp cho mọi nhóm trừ nhóm cuối.
			Badge nhóm: nhóm đầu bg-sky-900 text-sky-200, các nhóm sau bg-slate-800 text-slate-200 (tô theo VỊ TRÍ chứ không theo line).
			Mỗi thẻ nhà máy: PhotoSlot (nhãn dạng mã + tên, ký tự gạch dài ngăn cách, dùng làm chữ placeholder và aria-label),
			rồi huy hiệu mã xuất khẩu (bg-sky-700 ở thẻ lớn, bg-slate-700 ở thẻ gọn), tỉnh (chỉ thẻ lớn), tên và địa chỉ.
			Giá trị tùy chọn (province, address) chỉ render khi có để khỏi sinh thẻ p/span rỗng.
		*/}
		{
			groups.map((group, groupIndex) => {
				// Chế độ thẻ lớn nếu nhóm có từ 2 nhà máy trở xuống (ngưỡng ghi cứng).
				const large = group.plants.length <= 2;
				return (
					<div class:list={["reveal", groupIndex < groups.length - 1 && "mb-10"]}>
						<div class="mb-5 flex items-center gap-3">
							<span
								class:list={[
									"rounded px-3 py-1 text-xs font-bold tracking-widest uppercase",
									groupIndex === 0 ? "bg-sky-900 text-sky-200" : "bg-slate-800 text-slate-200",
								]}
							>
								{group.label}
							</span>
							<div class="h-px flex-1 bg-slate-100"></div>
						</div>
						<div class:list={["grid grid-cols-1 gap-4", large ? "md:grid-cols-2" : "sm:grid-cols-3"]}>
							{group.plants.map((plant) => (
								<article class="overflow-hidden rounded-xl border border-slate-200 transition-all hover:border-sky-200">
									<PhotoSlot
										image={plant.data.image}
										label={`${plant.data.code} — ${plant.data.title}`}
										class={large ? "h-48 sm:h-56" : "h-36"}
									/>
									<div class={large ? "p-5" : "p-4"}>
										<div class="mb-2 flex items-center justify-between">
											<span
												class:list={[
													"rounded font-black text-white",
													large ? "bg-sky-700 px-2.5 py-1 text-xs" : "bg-slate-700 px-2 py-0.5 text-xs",
												]}
											>
												{plant.data.code}
											</span>
											{large && plant.data.province && (
												<span class="text-xs text-slate-400">{plant.data.province}</span>
											)}
										</div>
										<h3 class:list={["font-bold text-slate-900", !large && "text-sm"]}>
											{plant.data.title}
										</h3>
										{plant.data.address && (
											<p class="mt-1 text-xs text-slate-400">{plant.data.address}</p>
										)}
									</div>
								</article>
							))}
						</div>
					</div>
				);
			})
		}
	</div>
</section>
